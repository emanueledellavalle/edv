<!-- _includes/courses.html -->
<div class="grid-sizer"></div>
<div class="grid-item">
  {% if course.redirect -%}
    <a href="{{ course.redirect }}">
  {%- else -%}
    <a href="{{ course.url | relative_url }}">
  {%- endif %}
      <div class="card hoverable">
        {%- if course.img %}
          {% assign thumbnail=course.img %}
        {% else %}
          {% assign thumbnail="assets/img/default_thumbnail_placeholder.jpg" | replace: "placeholder", course.category  %}

        {%- endif %}


        {%- include figure.liquid
          path=thumbnail
          alt="course thumbnail"
          center_caption=course.year -%}
        <div class="card-body">
          <h3 class="card-title text"> {{ course.title }}</h3>
          <p class="card-text">{{ course.description }}</p>
          <div class="row ml-1 mr-1 p-0">
            {%- if course.github -%}
            <div class="github-icon">
              <div class="icon" data-toggle="tooltip" title="Code Repository">
                <a href="{{ course.github }}"><i class="fab fa-github gh-icon"></i></a>
              </div>
            </div>
            {%- endif %}
          </div>
        </div>
      </div>
    </a>
</div>